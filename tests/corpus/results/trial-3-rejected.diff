+def test_detect_onsets_does_not_truncate_isolated_attacks():
+    signal = np.zeros(3 * SAMPLE_RATE, dtype=np.float32)
+    rng = np.random.default_rng(42)
+    starts = (0.5, 1.5, 2.5)
+    for start in starts:
+        index = round(start * SAMPLE_RATE)
+        signal[index : index + 220] = rng.uniform(-0.8, 0.8, 220)
+    detected = onsets.detect_onsets(signal, SAMPLE_RATE)
+    assert len(detected) == 3
+    assert all(0 <= actual - predicted <= 0.05 for actual, predicted in zip(starts, detected, strict=True))
