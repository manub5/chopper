@@ -63,6 +63,20 @@ def _cut_smoothness_score(
     return float(np.clip(1.0 - ratio, 0.0, 1.0))


+def _align_loop_start_to_attack(samples: np.ndarray, sample_rate: int, start: float) -> float:
+    left = max(0, round((start - 0.04) * sample_rate))
+    right = min(len(samples), round((start + 0.04) * sample_rate))
+    window = np.abs(samples[left:right])
+    if len(window) == 0:
+        return start
+    peak = float(np.max(window))
+    quiet_prefix = window[: max(1, round(0.005 * sample_rate))]
+    if peak <= 1e-9 or float(np.max(quiet_prefix)) > 0.1 * peak:
+        return start
+    attacks = np.flatnonzero(window >= 0.2 * peak)
+    return (left + int(attacks[0])) / sample_rate if len(attacks) else start
+
+
